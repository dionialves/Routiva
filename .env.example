# Copie para .env. Use aspas simples para senhas com #, espaços ou $.
ZABBIX_URL=https://seu-zabbix/api_jsonrpc.php
ZABBIX_USERNAME=seu-usuario
ZABBIX_PASSWORD='sua-senha-zabbix'

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scriptping
POSTGRES_USER=scriptping
POSTGRES_PASSWORD='troque-esta-senha'

PING_INTERVAL_MS=1000
PING_TIMEOUT_MS=1500
# Limite global de latência, em milissegundos.
PING_LATENCY_LIMIT_MS=20
# Manter pings após a agregação (yes/no). Prazo em minutos quando yes.
PING_KEEP_RAW=no
PING_RAW_RETENTION_MINUTES=2880
# Limpeza horária em transações pequenas.
PING_CLEANUP_ENABLED=true
PING_CLEANUP_BATCH_SIZE=1000
SERVER_ADDRESS=127.0.0.1
PORT=8080

# Porta publicada no servidor para o container Spring.
# Acesso direto: APP_BIND_ADDRESS=0.0.0.0 e APP_PORT=8080.
# Nginx na porta 8080: APP_BIND_ADDRESS=127.0.0.1 e APP_PORT=8081.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081

COLLECTOR_ADDRESS=unix:///run/routiva/collector.sock
# Opcional em desenvolvimento: caminho absoluto para iniciar um único processo.
COLLECTOR_EXECUTABLE=

# Indicator cycle log. Compose uses /var/log/routiva/indicators.log in a named volume.
INDICATORS_LOG_PATH=logs/indicators.log
INDICATORS_LOG_MAX_FILE_SIZE=10MB
INDICATORS_LOG_MAX_HISTORY=7
INDICATORS_LOG_TOTAL_SIZE_CAP=100MB

# Resumos por minuto: intervalo entre ciclos e máximo de pings por transação.
INDICATORS_AGGREGATION_INTERVAL_MS=60000
INDICATORS_AGGREGATION_PAGE_SIZE=10000

# Publicação de disponibilidade: processo independente da agregação.
INDICATORS_AVAILABILITY_INTERVAL_MS=60000
INDICATORS_AVAILABILITY_INITIAL_DELAY_MS=0

# Persistent collector queue: payload budget; database/WAL add disk overhead.
COLLECTOR_SPOOL_MAX_MIB=256
# 1..48 hours; oldest waiting batches are discarded at the limit.
COLLECTOR_SPOOL_MAX_AGE_HOURS=24
COLLECTOR_BATCH_SIZE=500
COLLECTOR_FLUSH_MS=100
COLLECTOR_RESULT_BUFFER=32768

# App-side negotiation: 1..32 unacknowledged batches per connection.
COLLECTOR_SEND_WINDOW=16
# Raw rows per PostgreSQL transaction: 5000..20000; wait: 0..1000 ms.
COLLECTOR_PERSISTENCE_MAX_RESULTS=5000
COLLECTOR_PERSISTENCE_WAIT_MS=100

# MikroTik: consulta somente leitura pela API nativa (RouterOS 6.43+ / 7).
MIKROTIK_USERNAME=''
MIKROTIK_PASSWORD=''
# API-SSL: certificado confiável e válido para o IP do host.
MIKROTIK_API_TLS=true
MIKROTIK_API_PORT=8729
# Para API sem TLS em rede protegida: TLS=false e PORT=8728.

# IXC Provedor — consulta de logins por MAC (somente leitura)
IXC_URL=''
# Token webservice original no formato id:token, sem codificar em Base64
IXC_TOKEN=''

# Login: habilite quando o acesso ao navegador usar HTTPS.
SESSION_COOKIE_SECURE=false
